diff --git a/workspace/all/minarch/ma_internal.h b/workspace/all/minarch/ma_internal.h
--- a/workspace/all/minarch/ma_internal.h
+++ b/workspace/all/minarch/ma_internal.h
@@
 struct Core {
@@
 	size_t (*get_memory_size)(unsigned id);
+
+	/* Optional NextUI Local Link extension. Normal libretro cores leave these NULL. */
+	unsigned (*local_link_get_abi_version)(void);
+	uint64_t (*local_link_get_capabilities)(void);
+	uint32_t (*local_link_get_loaded_mask)(void);
+	unsigned (*local_link_get_active_instance)(void);
+	bool (*local_link_set_active_instance)(unsigned slot);
+	bool (*local_link_add_instance)(unsigned slot, const struct retro_game_info *game);
+	bool (*local_link_remove_instance)(unsigned slot);
+	void *(*local_link_get_memory_data)(unsigned slot, unsigned id);
+	size_t (*local_link_get_memory_size)(unsigned slot, unsigned id);
+	size_t (*local_link_serialize_size)(unsigned slot);
+	bool (*local_link_serialize)(unsigned slot, void *data, size_t size);
+	bool (*local_link_unserialize)(unsigned slot, const void *data, size_t size);
 
 	retro_core_options_update_display_callback_t update_visibility_callback;
 };
diff --git a/workspace/all/minarch/ma_core.c b/workspace/all/minarch/ma_core.c
--- a/workspace/all/minarch/ma_core.c
+++ b/workspace/all/minarch/ma_core.c
@@
 	core.get_memory_data = dlsym(core.handle, "retro_get_memory_data");
 	core.get_memory_size = dlsym(core.handle, "retro_get_memory_size");
+
+	/* Optional Local Link ABI. dlsym returns NULL for ordinary cores. */
+	core.local_link_get_abi_version = dlsym(core.handle, "retro_local_link_get_abi_version");
+	core.local_link_get_capabilities = dlsym(core.handle, "retro_local_link_get_capabilities");
+	core.local_link_get_loaded_mask = dlsym(core.handle, "retro_local_link_get_loaded_mask");
+	core.local_link_get_active_instance = dlsym(core.handle, "retro_local_link_get_active_instance");
+	core.local_link_set_active_instance = dlsym(core.handle, "retro_local_link_set_active_instance");
+	core.local_link_add_instance = dlsym(core.handle, "retro_local_link_add_instance");
+	core.local_link_remove_instance = dlsym(core.handle, "retro_local_link_remove_instance");
+	core.local_link_get_memory_data = dlsym(core.handle, "retro_local_link_get_memory_data");
+	core.local_link_get_memory_size = dlsym(core.handle, "retro_local_link_get_memory_size");
+	core.local_link_serialize_size = dlsym(core.handle, "retro_local_link_serialize_size");
+	core.local_link_serialize = dlsym(core.handle, "retro_local_link_serialize");
+	core.local_link_unserialize = dlsym(core.handle, "retro_local_link_unserialize");
 	
 	void (*set_environment_callback)(retro_environment_t);
